    --bg: #f6f7f9;
    --card: #ffffff;
    --ink: #1f2430;
    --muted: #6b7280;
    --line: #e5e7eb;
    --amber: #d97706;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB",
      "Microsoft YaHei", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background: var(--bg);
    color: var(--ink);
    line-height: 1.5;
  }
  .page { max-width: 1240px; margin: 0 auto; padding: 20px 16px 40px; }

  /* ---------- 顶部导航占位 ---------- */
  nav {
    display: flex; align-items: center; gap: 14px;
    padding: 8px 0 14px; border-bottom: 1px solid var(--line);
    margin-bottom: 22px; flex-wrap: wrap;
  }
  nav .brand { font-weight: 700; color: var(--amber); margin-right: 8px; letter-spacing: .5px; }
  nav .tab { color: var(--ink); font-weight: 600; padding: 4px 2px; border-bottom: 2px solid var(--amber); }
  nav .tab.off { color: var(--muted); font-weight: 500; border-bottom: 2px solid transparent; }
  nav .sep { color: #c2c7cf; }

  /* ---------- 标题 ---------- */
  header h1 { margin: 0 0 6px; font-size: 26px; letter-spacing: .3px; }
  header h1 .en { color: var(--amber); }
  header .subtitle { margin: 0; color: var(--muted); font-size: 14.5px; }
  header .subtitle strong { color: var(--ink); }
  header .sub-en { margin: 4px 0 0; color: #9aa0a8; font-size: 12.5px; }

  /* ---------- 图例 ---------- */
  .legend {
    background: var(--card); border: 1px solid var(--line); border-radius: 10px;
    padding: 14px 16px; margin: 20px 0 18px;
    display: flex; flex-wrap: wrap; gap: 10px 26px; align-items: center;
  }
  .legend .item { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--ink); }
  .legend .swatch {
    width: 18px; height: 18px; border-radius: 5px; flex: 0 0 auto;
    background: hsl(var(--amber-h), var(--amber-s), 55%);
    border: 1px solid hsl(var(--amber-h), 70%, 45%);
  }
  .legend .swatch.gray { background: #eef0f3; border-color: #d6dae0; }
  .legend .swatch.host { background: #f0f1f3; border: 1.5px dashed var(--amber); }
  .legend .grad {
    width: 150px; height: 14px; border-radius: 7px;
    background: linear-gradient(to right, hsl(36,92%,80%), hsl(36,92%,34%));
    flex: 0 0 auto;
  }
  .legend .grad-wrap { display: flex; align-items: center; gap: 8px; }
  .legend .grad-label { font-size: 11px; color: var(--muted); }
  .legend .note { flex-basis: 100%; font-size: 12.5px; color: var(--muted); margin-top: 2px; }

  /* ---------- 周期表 ---------- */
  .table-wrap { overflow-x: auto; }
  .grid {
    display: grid;
    grid-template-columns: repeat(18, minmax(0, 1fr));
    gap: 5px;
    min-width: 1080px;
  }
  .el {
    position: relative;
    min-height: 66px;
    padding: 4px 5px;
    border-radius: 8px;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    background: #eef0f3; color: #8a9099;
    border: 1px solid #e2e5ea;
    transition: transform .06s ease, box-shadow .06s ease;
  }
  .el:hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(0,0,0,.12); z-index: 2; }
  .el .top { display: flex; justify-content: space-between; align-items: center; width: 100%; }
  .el .num { font-size: 9px; line-height: 1; opacity: .72; font-weight: 600; }
  .el .sym { font-size: 20px; line-height: 1.05; font-weight: 800; letter-spacing: .3px; }
  .el .zh { font-size: 9.5px; line-height: 1.1; opacity: .85; margin-top: 2px; }
  .badge {
    font-size: 9px; font-weight: 700; line-height: 1.25;
    border: 1px solid currentColor; border-radius: 8px; padding: 0 4px;
    background: rgba(127,127,127,.16);
  }
  .tag {
    font-size: 8px; font-weight: 700; line-height: 1.25;
    color: var(--amber); border: 1px dashed var(--amber); border-radius: 4px; padding: 0 3px;
  }
  .el.hi { border: 1px solid hsl(var(--amber-h), 70%, 52%); }
  .el.host { border: 1.5px dashed var(--amber); }
  .ph {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    background: #fafbfc; border: 1px dashed #d0d4da; color: #8a9099;
    border-radius: 8px; font-size: 11px; font-weight: 600; min-height: 66px;
  }
  .ph span { font-size: 9px; font-weight: 500; opacity: .8; }
  .rowlabel {
    display: flex; align-items: center; justify-content: center;
    font-size: 11px; color: var(--muted); font-weight: 600; min-height: 66px;
  }

  /* ---------- 页脚 ---------- */
  footer {
    margin-top: 26px; padding-top: 14px; border-top: 1px solid var(--line);
    color: var(--muted); font-size: 12.5px;
  }
  footer code { background: #eceef1; border-radius: 4px; padding: 1px 5px; color: var(--ink); }

  @media (max-width: 720px) {
    header h1 { font-size: 21px; }
    .el { min-height: 56px; }
    .el .sym { font-size: 16px; }
    .el .zh { font-size: 8.5px; }
    .el .num { font-size: 8px; }
  }
</style>
</head>
